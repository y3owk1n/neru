---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { LinkCard, CardGrid } from '@astrojs/starlight/components';
import { channel, channelBases, docHref, latestVersion, movedSections, renamedPages, siteTitle, splitPages } from '../site.mjs';

const title = 'Page not found';
const other = channel === 'latest' ? 'nightly' : 'latest';
const otherLabel = channel === 'latest' ? 'Nightly docs' : `Docs for ${latestVersion}`;
---

<StarlightPage
  frontmatter={{
    title,
    description: 'This page does not exist.',
    head: [{ tag: 'meta', attrs: { property: 'og:title', content: `${title} | ${siteTitle}` } }],
    tableOfContents: false,
    editUrl: false,
    pagefind: false,
  }}
>
  <p
    data-redirect
    data-bases={JSON.stringify(channelBases)}
    data-renamed={JSON.stringify(renamedPages)}
    data-split={JSON.stringify(splitPages)}
    data-sections={JSON.stringify(movedSections)}>
    This page does not exist in these docs. It may live in the other version, or under a new name.
    Pages that were files such as <code>CONFIGURATION.md</code> now sit under Guide and Reference.
    Search finds any page by its title.
  </p>
  <CardGrid>
    <LinkCard title="Getting started" href={docHref('guide/getting-started.md', 'INSTALLATION.md')} />
    <LinkCard title="Configuration reference" href={docHref('reference/configuration.md', 'CONFIGURATION.md')} />
    <LinkCard title="CLI reference" href={docHref('reference/cli.md', 'CLI.md')} />
    <LinkCard title={otherLabel} href={channelBases[other]} />
  </CardGrid>
</StarlightPage>

<script>
  import { redirectFor } from '../scripts/switch-channel';

  // Send a missing URL to the page it most likely meant, or the docs root.
  const target = await redirectFor(document.querySelector<HTMLElement>('[data-redirect]')!);
  if (target) location.replace(target);
</script>
