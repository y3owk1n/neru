---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { channel, channelBases, latestVersion, movedSections, renamedPages, splitPages } from '../site.mjs';

// `astro dev` builds the nightly channel only, so there is nothing to switch to.
const dev = import.meta.env.DEV;
---

<label class="version">
  <span class="sr-only">Docs version</span>
  <select
    disabled={dev}
    title={dev ? 'Only nightly is served in dev. Run just website-build, then just website-preview, to switch versions.' : undefined}
    data-bases={JSON.stringify(channelBases)}
    data-renamed={JSON.stringify(renamedPages)}
    data-split={JSON.stringify(splitPages)}
    data-sections={JSON.stringify(movedSections)}>
    <option value="latest" selected={channel === 'latest'}>{latestVersion}</option>
    <option value="nightly" selected={channel === 'nightly'}>nightly</option>
  </select>
</label>
<Default />

<script>
  import { pageIn } from '../scripts/switch-channel';

  for (const select of document.querySelectorAll<HTMLSelectElement>('.version select')) {
    const current = select.value;
    select.addEventListener('change', async () => {
      const target = await pageIn(select.value, select);
      if (target) location.href = target;
      else select.value = current;
    });
  }
</script>

<style>
  .version select {
    min-height: 2.75rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    padding: 0.5rem 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    margin-inline-end: 0.5rem;
    cursor: pointer;
  }
  .version select:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
  }
  .version select:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .version option {
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-1);
  }
</style>
