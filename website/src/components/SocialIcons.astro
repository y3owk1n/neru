---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { channel, channelBases, latestVersion, renamedPages, splitPages } from '../site.mjs';
---

<label class="version">
  <span class="sr-only">Docs version</span>
  <select data-bases={JSON.stringify(channelBases)} data-renamed={JSON.stringify(renamedPages)} data-split={JSON.stringify(splitPages)}>
    <option value="latest" selected={channel === 'latest'}>{latestVersion}</option>
    <option value="nightly" selected={channel === 'nightly'}>nightly</option>
  </select>
</label>
<Default />

<script>
  import { pageIn } from '../scripts/switch-channel';

  for (const select of document.querySelectorAll<HTMLSelectElement>('.version select')) {
    select.addEventListener('change', async () => {
      location.href = await pageIn(select.value, select);
    });
  }
</script>

<style>
  .version select {
    min-height: 2.75rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    padding: 0.5rem 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    margin-inline-end: 0.5rem;
    cursor: pointer;
  }
  .version select:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
  }
  .version select:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .version option {
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-1);
  }
</style>
